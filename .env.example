# Rename to .env and fill in. NEVER commit the real .env.

GEMINI_API_KEY=your_gemini_key_here
CHANNEL3_API_KEY=your_channel3_key_here

# PayPal sandbox - MUST be a Business account from a PayPal-supported
# receiving country (US/UK/DE/etc).
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_secret
PAYPAL_MERCHANT_ID=optional_explicit_payee_merchant_id
# FIXED 2026-10-27: web app runs on port 5000 (not 8000), and it has
# no /paypal/return route, so use the home page for both URLs.
PAYPAL_RETURN_URL=http://localhost:5000/
PAYPAL_CANCEL_URL=http://localhost:5000/

# Debug: set to 1 to print the raw first-product JSON from Channel3
# so you can verify the unverified schema.
DEBUG_CHANNEL3=0
